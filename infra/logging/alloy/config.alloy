logging {
  level  = "info"
  format = "logfmt"
}

local.file_match "docker_logs" {
  path_targets = [
    {
      __path__ = "/var/lib/docker/containers/*/*-json.log",
      job      = "docker",
    },
  ]
}

loki.process "docker_logs" {
  stage.json {
    expressions = {
      log    = "log",
      stream = "stream",
      time   = "time",
    }
  }

  stage.timestamp {
    source = "time"
    format = "RFC3339Nano"
  }

  stage.labels {
    values = {
      stream = "",
    }
  }

  stage.output {
    source = "log"
  }

  forward_to = [loki.write.default.receiver]
}

loki.source.file "docker_logs" {
  targets    = local.file_match.docker_logs.targets
  forward_to = [loki.process.docker_logs.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://genesis-logging-loki:3100/loki/api/v1/push"
  }
}
